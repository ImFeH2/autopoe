{
  "name": "flowent-app",
  "private": true,
  "version": "0.0.0",
  "description": "Flowent desktop app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:components": "vite --open /component-lab.html",
    "dev:desktop": "pnpm dev",
    "build:frontend": "tsc && vite build",
    "build:desktop": "pnpm build:frontend && pnpm build:flowent",
    "build:debug:frontend": "tsc && vite build --mode debug --outDir dist-debug && pnpm build:flowent",
    "build:flowent": "pnpm --workspace-root run build:flowent",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/tauri-plugin": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
