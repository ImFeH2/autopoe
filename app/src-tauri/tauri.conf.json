{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowent",
  "version": "../package.json",
  "identifier": "im.feh2.flowent",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flowent",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "maximized": false,
        "visible": false,
        "focus": false,
        "focusable": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/flowent"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
