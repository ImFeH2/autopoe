{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "im.feh2.flowent.debug",
  "build": {
    "beforeBuildCommand": "pnpm build:debug:frontend",
    "frontendDist": "../dist-debug"
  },
  "bundle": {
    "externalBin": ["binaries/flowent"]
  },
  "app": {
    "windows": [
      {
        "title": "Flowent",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "maximized": false,
        "focus": false,
        "visible": false,
        "focusable": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "debug",
          "description": "Capability for local desktop debugging",
          "windows": ["main"],
          "permissions": ["wdio:default", "core:window:allow-set-size"]
        }
      ]
    }
  }
}
