FROM node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends bubblewrap git ripgrep \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace

COPY --from=ghcr.io/astral-sh/uv:0.8.14@sha256:f3660c56d5b08d6c516360981bedc439f499b9bf37f46a216018da3777a74011 /uv /uvx /usr/local/bin/

RUN corepack enable \
  && corepack prepare pnpm@10.29.3 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json ./frontend/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store HUSKY=0 pnpm install --frozen-lockfile

COPY backend/pyproject.toml backend/uv.lock backend/README.md ./backend/
COPY backend/src ./backend/src
RUN uv sync --project backend --frozen --no-install-package flowent-native

COPY . .

EXPOSE 6873

CMD ["pnpm", "dev"]
