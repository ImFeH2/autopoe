{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "changelog": "",
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "requireUpstream": true,
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "push": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": "pnpm verify",
    "after:bump": ["uv lock --project flowent", "node scripts/cargo.mjs check"]
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        {
          "file": "app/package.json",
          "path": "version"
        },
        {
          "file": "app/src-tauri/Cargo.toml",
          "path": "package.version"
        },
        {
          "file": "flowent/pyproject.toml",
          "path": "project.version"
        }
      ]
    }
  }
}
