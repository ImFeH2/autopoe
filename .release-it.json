{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "git": {
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "requireUpstream": true,
    "commit": true,
    "commitMessage": "chore: release v${version}",
    "commitArgs": ["--gpg-sign"],
    "tag": true,
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "tagArgs": ["--sign"],
    "push": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        {
          "file": "backend/pyproject.toml",
          "type": "text/plain"
        },
        {
          "file": "native/flowent-native/Cargo.toml",
          "path": "package.version"
        },
        {
          "file": "native/flowent-sandbox-windows/Cargo.toml",
          "path": "package.version"
        },
        {
          "file": "native/flowent-native/Cargo.lock",
          "type": "text/plain"
        },
        {
          "file": "native/flowent-sandbox-windows/Cargo.lock",
          "type": "text/plain"
        }
      ]
    }
  },
  "hooks": {
    "after:bump": [
      "uv lock --project backend",
      "python scripts/release/check_versions.py"
    ]
  }
}
