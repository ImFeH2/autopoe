{
  "name": "flowent",
  "private": true,
  "version": "0.0.0",
  "description": "Just say what you need. Flowent gets it done.",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:components": "vite --open /component-lab.html",
    "dev:desktop": "pnpm build:sidecar && pnpm dev",
    "build": "tsc && vite build",
    "build:desktop": "pnpm build && pnpm build:sidecar",
    "build:desktop:debug": "node scripts/build-desktop-debug.mjs",
    "build:desktop:debug:frontend": "tsc && vite build --mode desktop-debug --outDir dist-desktop-debug && pnpm build:sidecar",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "check": "biome check . && pnpm typecheck",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "preview": "vite preview",
    "release": "release-it",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "lefthook run pre-commit --force"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@release-it/bumper": "^8.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "lefthook": "^2.1.10",
    "release-it": "^21.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
