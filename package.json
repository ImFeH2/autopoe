{
  "name": "flowent",
  "version": "0.3.7",
  "description": "A workflow orchestration platform for multi-agent collaboration",
  "author": "ImFeH2 <i@feh2.im>",
  "license": "Apache-2.0",
  "keywords": [
    "agent",
    "agents",
    "ai",
    "ai-agents",
    "assistant",
    "automation",
    "code-generation",
    "llm",
    "mcp",
    "orchestration",
    "sandbox",
    "web-application",
    "workflow"
  ],
  "private": false,
  "bin": {
    "flowent": "bin/flowent.mjs"
  },
  "files": [
    "assets/",
    "backend/.python-version",
    "backend/pyproject.toml",
    "backend/README.md",
    "backend/src/",
    "!backend/src/**/__pycache__/",
    "!backend/src/**/*.pyc",
    "backend/uv.lock",
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImFeH2/flowent.git"
  },
  "bugs": {
    "url": "https://github.com/ImFeH2/flowent/issues"
  },
  "homepage": "https://github.com/ImFeH2/flowent#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c cyan,magenta \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "uv run --project backend uvicorn flowent.main:app --reload --host 127.0.0.1 --port 6874",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:frontend": "pnpm --dir frontend build",
    "build:backend": "node scripts/prepare-python-package.mjs && uv build --project backend",
    "build:npm": "pnpm build && node scripts/prepare-npm-package.mjs",
    "start": "uv run --project backend flowent",
    "check": "pnpm check:frontend && pnpm check:backend",
    "check:fix": "biome check --write . && uv run --project backend ruff format && uv run --project backend ruff check --fix",
    "check:frontend": "pnpm --dir frontend check",
    "check:backend": "node scripts/prepare-python-readme.mjs && uv run --project backend ruff format --check && uv run --project backend ruff check && uv run --project backend mypy --config-file backend/pyproject.toml backend/src",
    "typecheck": "pnpm --dir frontend typecheck",
    "test": "pnpm test:frontend && pnpm test:backend",
    "test:frontend": "pnpm --dir frontend test",
    "test:backend": "node scripts/prepare-python-readme.mjs && uv run --project backend pytest",
    "test:watch": "pnpm --dir frontend test:watch",
    "release": "release-it --dry-run",
    "release:exec": "release-it",
    "prepack": "pnpm build:npm",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,cts,json,jsonc,css}": "biome check --write --no-errors-on-unmatched",
    "*.py": [
      "uv run --project backend ruff format",
      "uv run --project backend ruff check --fix"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@release-it/bumper": "^7.0.5",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "release-it": "^20.0.1"
  }
}
