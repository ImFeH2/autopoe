{
  "name": "flowent",
  "private": true,
  "version": "0.0.1",
  "description": "Just say what you need. Flowent gets it done.",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:desktop": "pnpm build && pnpm build:sidecar",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:sidecar": "node scripts/smoke-sidecar.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
