{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "im.feh2.flowent.desktop-debug",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop:debug:frontend",
    "frontendDist": "../dist-desktop-debug"
  },
  "bundle": {
    "externalBin": ["binaries/flowent-agent"]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "desktop-debug",
          "description": "Capability for local desktop debugging",
          "windows": ["main"],
          "permissions": ["wdio:default", "core:window:allow-set-size"]
        }
      ]
    }
  }
}
